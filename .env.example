# Application port
PORT=3000

# Use your own MongoDB Atlas connection string or a local MongoDB URI.
# For local MongoDB: mongodb://127.0.0.1:27017/diabetes_prediction
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/diabetes_prediction?retryWrites=true&w=majority

# Generate a long, unique random secret; do not reuse this placeholder.
JWT_SECRET=replace_with_a_long_random_secret

# Python executable: activate .venv before npm start, or use an absolute path.
# Docker overrides this with python3.
PYTHON_PATH=python
